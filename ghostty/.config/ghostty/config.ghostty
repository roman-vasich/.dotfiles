shell-integration = zsh
macos-option-as-alt = true
mouse-hide-while-typing = true
macos-option-as-alt = true

window-save-state = always
window-step-resize = true

clipboard-read = allow
clipboard-write = allow

shell-integration-features = sudo,ssh-terminfo,ssh-env

# UI

background-opacity = 0.85
background-blur-radius = 20
theme =Dracula+
unfocused-split-opacity = 0.85

# Keybinds

## Keybindings Focus (Zoom) Mode

keybind = ctrl+f=toggle_split_zoom
keybind = chain=activate_key_table:focus

keybind = focus/ctrl+h=ignore
keybind = focus/ctrl+j=ignore
keybind = focus/ctrl+k=ignore
keybind = focus/ctrl+l=ignore

keybind = focus/ctrl+f=toggle_split_zoom
keybind = chain=deactivate_key_table

# Mark pane navigation as performable to allow passing
# vim-mode navigation to the shell instead of entering
# focus mode (see above).
keybind = performable:ctrl+h=goto_split:left
keybind = performable:ctrl+j=goto_split:bottom
keybind = performable:ctrl+k=goto_split:top
keybind = performable:ctrl+l=goto_split:right

keybind = ctrl+a>h=new_split:left
keybind = ctrl+a>j=new_split:down
keybind = ctrl+a>k=new_split:up
keybind = ctrl+a>l=new_split:right

keybind = ctrl+shift+h=resize_split:left,25
keybind = ctrl+shift+l=resize_split:right,25
keybind = ctrl+shift+j=resize_split:down,25
keybind = ctrl+shift+k=resize_split:up,25

keybind = ctrl+n=new_tab
keybind = ctrl+a>n=next_tab
keybind = ctrl+a>p=previous_tab

keybind = ctrl+shift+r=reload_config

# Send the explicit escape sequence for Ctrl + / directly to the terminal application
keybind = ctrl+/=text:\x1f
